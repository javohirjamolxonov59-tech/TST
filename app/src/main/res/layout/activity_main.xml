<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Верхние вкладки: Текст / Файл -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:tabIndicatorColor="@color/tab_border"
        app:tabSelectedTextColor="@color/tab_border"
        app:tabTextColor="@color/tab_text"
        android:background="@color/background"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tab_border" />

    <!-- Контент вкладок (текст / файл) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tab_border" />

    <!-- Нижняя панель: Назад / Пауза / Вперёд -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/control_bar_bg">

        <Button
            android:id="@+id/btnBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_back"
            android:textAllCaps="false" />

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/tab_border" />

        <Button
            android:id="@+id/btnPause"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_pause"
            android:textAllCaps="false" />

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/tab_border" />

        <Button
            android:id="@+id/btnForward"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_forward"
            android:textAllCaps="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tab_border" />

    <!-- Прошло / Всего -->
    <TextView
        android:id="@+id/playbackTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="6dp"
        android:text="00:00 / 00:00"
        android:textColor="@color/tab_text"
        android:textSize="14sp" />

    <!-- Строка тон/скорость -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_tone"
            android:textColor="@color/tab_text"
            android:layout_marginEnd="8dp" />

        <SeekBar
            android:id="@+id/seekTone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_speed"
            android:textColor="@color/tab_text"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp" />

        <SeekBar
            android:id="@+id/seekSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50" />
    </LinearLayout>

</LinearLayout>
